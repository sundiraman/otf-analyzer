# Copy this file to scripts/.env (or workspace .env) and fill values.

# Microsoft Graph OAuth
OTF_GRAPH_CLIENT_ID=your-azure-app-client-id
OTF_GRAPH_TENANT=consumers
OTF_GRAPH_TOKEN_CACHE=data/graph_token.json
# Leave blank to avoid filtering by sender
OTF_GRAPH_SENDER=
# Use exact folder name/path from --graph-list-folders output
OTF_GRAPH_FOLDER=OrangeTheory

# Optional output overrides
# OTF_CSV=data/otf_classes.csv
# OTF_REPORT=data/otf_report.md
