# Copy this file to scripts/.env (or workspace .env) and fill values.

# Microsoft Graph OAuth
OTF_GRAPH_CLIENT_ID=your-azure-app-client-id
OTF_GRAPH_TENANT=common
OTF_GRAPH_TOKEN_CACHE=data/graph_token.json
OTF_GRAPH_SENDER=orangetheory

